UNITS LENGTH=A TIME=fs ENERGY=eV
targetCu: GROUP ATOMS=<TARGET_CU>
otherCu: GROUP ATOMS=<OTHER_CU>
topCu: GROUP ATOMS=<TOP_CU>
waterO: GROUP ATOMS=<WATER_O>
cn: COORDINATION GROUPA=targetCu GROUPB=otherCu R_0=3.0 NN=6 MM=12
cno: COORDINATION GROUPA=targetCu GROUPB=waterO R_0=2.6 NN=12 MM=24
surf: COM ATOMS=topCu NOPBC
height: DISTANCE ATOMS=surf,targetCu COMPONENTS NOPBC
lwall: LOWER_WALLS ARG=height.z AT=-1.6 KAPPA=500.0
uwall: UPPER_WALLS ARG=height.z AT=10.0 KAPPA=10.0
cnwall: UPPER_WALLS ARG=cn AT=11.5 KAPPA=50.0
opes: OPES_METAD FILE=Kernels.data TEMP=300 ARG=height.z,cno PACE=200 BARRIER=3.0 SIGMA_MIN=0.05,0.05 STATE_WFILE=State.data STATE_WSTRIDE=200000 STORE_STATES EXTRA_BIAS=uwall.bias,lwall.bias,cnwall.bias
PRINT FMT=%g STRIDE=100 FILE=COLVAR ARG=cn,cno,height.z,opes.*,uwall.bias,lwall.bias,cnwall.bias
FLUSH STRIDE=5000
