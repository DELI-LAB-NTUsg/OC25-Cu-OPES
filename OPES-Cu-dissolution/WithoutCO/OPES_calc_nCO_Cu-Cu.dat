UNITS LENGTH=A TIME=fs ENERGY=eV

cn: COORDINATION GROUPA=119 GROUPB=1-118,120-192 R_0=3.0 NN=6 MM=12
waterO: GROUP ATOMS=196-622:3
cno: COORDINATION GROUPA=119 GROUPB=waterO R_0=2.6 NN=12 MM=24
topCu: GROUP ATOMS=3-118:4,123-191:4

surf: COM ATOMS=topCu NOPBC
height: DISTANCE ATOMS=surf,119 COMPONENTS NOPBC
uwall: UPPER_WALLS ARG=cn AT=9.5 KAPPA=2000.0

opes: OPES_METAD FILE=Kernels_Cu-Cu.data TEMP=300 ARG=cn PACE=200 BARRIER=2.0 SIGMA_MIN=0.05 STATE_WFILE=State_Cu-Cu.data STATE_WSTRIDE=5000 STORE_STATES EXTRA_BIAS=uwall.bias

PRINT FMT=%g STRIDE=100 FILE=COLVAR_Cu-Cu ARG=cn,cno,height.z,opes.*,uwall.bias