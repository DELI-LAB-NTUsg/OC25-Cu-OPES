UNITS LENGTH=A TIME=fs ENERGY=eV

cn: COORDINATION GROUPA=119 GROUPB=1-118,120-192 R_0=3.0 NN=6 MM=12
waterO: GROUP ATOMS=195-621:3
cno: COORDINATION GROUPA=119 GROUPB=waterO R_0=2.6 NN=12 MM=24
topCu: GROUP ATOMS=3-118:4,123-191:4
c_cu: DISTANCE ATOMS=193,119

surf: COM ATOMS=topCu NOPBC
height: DISTANCE ATOMS=surf,119 COMPONENTS NOPBC
uwall: UPPER_WALLS ARG=cn,c_cu AT=9.5,2.3 KAPPA=2000.0,2000.0

opes: OPES_METAD FILE=Kernels_Cu-Cu_Cu-O.data TEMP=300 ARG=cn,cno PACE=200 BARRIER=2.0 SIGMA_MIN=0.05,0.05 STATE_WFILE=State_Cu-Cu_Cu-O.data STATE_WSTRIDE=5000 STORE_STATES EXTRA_BIAS=uwall.bias

PRINT FMT=%g STRIDE=100 FILE=COLVAR_Cu-Cu_Cu-O ARG=cn,c_cu,cno,height.z,opes.*,uwall.bias