UNITS LENGTH=A TIME=fs ENERGY=eV

targetCu: GROUP ATOMS=185
otherCu: GROUP ATOMS=1-184,186-288
topCu: GROUP ATOMS=5-179:6,191-287:6
waterO: GROUP ATOMS=291,292-718:3


cn: COORDINATION GROUPA=targetCu GROUPB=otherCu R_0=3.0 NN=6 MM=12
cno: COORDINATION GROUPA=targetCu GROUPB=waterO R_0=2.6 NN=12 MM=24
surf: COM ATOMS=topCu NOPBC
height: DISTANCE ATOMS=surf,targetCu COMPONENTS NOPBC

lwall: LOWER_WALLS ARG=height.z AT=-1.0 KAPPA=10.0
uwall: UPPER_WALLS ARG=height.z AT=12.0 KAPPA=10.0

opes: OPES_METAD FILE=Kernels_nCO.data TEMP=300 ARG=height.z,cno PACE=200 BARRIER=3.0 SIGMA_MIN=0.05,0.05 STATE_WFILE=State_nCO.data STATE_WSTRIDE=5000 STORE_STATES EXTRA_BIAS=uwall.bias,lwall.bias

PRINT FMT=%g STRIDE=100 FILE=COLVAR_nCO ARG=cn,cno,height.z,opes.*,uwall.bias,lwall.bias